{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "",
    "ExpiryMinutes": 30
  },
  "Http": {
    "UserAgent": "UclAggregator/1.0"
  },
  "Aggregator": {
    "DefaultKeywords": "Champions League",
    "TopPlayersWithNews": 3,
    "DefaultNewsLimit": 20,
    "NewsHalfLifeDays": 7,
    "NewsFallbackMaxArticles": 1,
    "CacheHours": 2
  },
  "Espn": {
    "BaseUrl": "https://site.web.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/",
    "StandingsUrl": "https://site.web.api.espn.com/apis/v2/sports/soccer/uefa.champions/standings"
  },
  "TheSportsDb": {
    "BaseUrl": "https://www.thesportsdb.com/api/v1/json/123/"
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com/",
    "GeocodingUrl": "https://geocoding-api.open-meteo.com/v1/search",
    "ForecastUrl": "https://api.open-meteo.com/v1/forecast",
    "ArchiveUrl": "https://archive-api.open-meteo.com/v1/archive",
    "Hourly": "temperature_2m,precipitation,wind_speed_10m,weather_code",
    "GeocodeCount": 10,
    "ForecastPastDays": 90
  },
  "GoogleNews": {
    "BaseUrl": "https://news.google.com/rss/",
    "Language": "en-GB",
    "Region": "GB",
    "Edition": "GB:en",
    "MaxItems": 20
  },
  "Guardian": {
    "BaseUrl": "https://content.guardianapis.com/",
    "ApiKey": "",
    "Section": "football",
    "OrderBy": "relevance",
    "PageSize": 20
  }
}
